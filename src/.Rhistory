# Clear workspace
rm(list = ls())
# Set seed for reproducibility
set.seed(123)
B <- 1000              # Number of simulations
beta0 <- 2             # True intercept
beta1 <- 6             # True slope (last digit of roll number)
mu_x <- 10             # Mean of X
sigma2_x <- 6           # Variance of X
sigma2_e <- 6           # Variance of error term
# Standard deviations
sigma_x <- sqrt(sigma2_x)
sigma_e <- sqrt(sigma2_e)
n <- 50
# Store the 1000 estimates
beta1_hat <- numeric(B)
for (b in 1:B) {
# Generate X
X <- rnorm(n, mean = mu_x, sd = sigma_x)
# Generate error
epsilon <- rnorm(n, mean = 0, sd = sigma_e)
# Generate Y
Y <- beta0 + beta1 * X + epsilon
# Calculate OLS estimate of beta1
beta1_hat[b] <- sum((X - mean(X)) * (Y - mean(Y))) /
sum((X - mean(X))^2)
}
# View first few estimates
head(beta1_hat)
mean_beta1 <- mean(beta1_hat)
sd_beta1 <- sd(beta1_hat)
cat("Mean of beta1_hat =", mean_beta1, "\n")
cat("SD of beta1_hat   =", sd_beta1, "\n")
cat("True beta1        =", beta1, "\n")
# Compare simulated mean with true beta1
cat("\nDifference between simulated mean and true beta1 =",
mean_beta1 - beta1, "\n")
hist(beta1_hat,
breaks = 30,
probability = TRUE,
main = expression(paste("Sampling Distribution of ",
hat(beta)[1])),
xlab = expression(hat(beta)[1]),
col = "lightblue",
border = "white")
# Add density curve
lines(density(beta1_hat),
lwd = 2)
# Mark true beta1
abline(v = beta1,
lwd = 2,
lty = 2)
# Add legend
legend("topright",
legend = c("Density", "True beta1 = 6"),
lty = c(1, 2),
lwd = c(2, 2))
sample_sizes <- c(10, 50, 100, 500)
# Create empty vectors to store results
simulated_mean <- numeric(length(sample_sizes))
simulated_sd <- numeric(length(sample_sizes))
# Store all estimates for plotting later
all_estimates <- list()
for (j in 1:length(sample_sizes)) {
n <- sample_sizes[j]
# Vector to store beta1 estimates
estimates <- numeric(B)
for (b in 1:B) {
# Generate X
X <- rnorm(n, mean = mu_x, sd = sigma_x)
# Generate error
epsilon <- rnorm(n, mean = 0, sd = sigma_e)
# Generate Y
Y <- beta0 + beta1 * X + epsilon
# OLS slope estimator
estimates[b] <- sum((X - mean(X)) * (Y - mean(Y))) /
sum((X - mean(X))^2)
}
# Store estimates
all_estimates[[as.character(n)]] <- estimates
# Calculate mean and SD
simulated_mean[j] <- mean(estimates)
simulated_sd[j] <- sd(estimates)
}
results <- data.frame(
n = sample_sizes,
Mean_beta1_hat = simulated_mean,
SD_beta1_hat = simulated_sd
)
print(results)
par(mfrow = c(2, 2))
for (n in sample_sizes) {
estimates <- all_estimates[[as.character(n)]]
hist(estimates,
breaks = 30,
probability = TRUE,
main = paste("n =", n),
xlab = expression(hat(beta)[1]),
col = "lightblue",
border = "white")
# Density
lines(density(estimates),
lwd = 2)
# True beta1
abline(v = beta1,
lwd = 2,
lty = 2)
}
# Return plotting layout to normal
par(mfrow = c(1, 1))
write.csv(results,
"assignment2_results.csv",
row.names = FALSE)
View(all_estimates)
View(results)
